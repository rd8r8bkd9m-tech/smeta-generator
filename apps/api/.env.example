# ===========================================
# SMETA PRO API - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# Database
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smeta_pro

# Redis
# Redis connection for caching and sessions
REDIS_URL=redis://localhost:6379

# Authentication
# Secret key for JWT tokens (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Server
# Port for the API server
PORT=4000

# Environment
# development | production | test
NODE_ENV=development

# AI Integration (Optional)
# Google AI API key for Genkit/Gemini
# Without this key, AI features will work in demo mode
GOOGLE_AI_API_KEY=

# Telegram Bot (Optional)
# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Logging
# debug | info | warn | error
LOG_LEVEL=info

# CORS
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Rate Limiting
# Maximum requests per minute per IP
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
